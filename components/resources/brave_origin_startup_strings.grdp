<?xml version="1.0" encoding="UTF-8"?>
<grit-part>
  <message name="IDS_BRAVE_ORIGIN_STARTUP_TITLE" desc="Title for the Galeob startup dialog" formatter_data="webui=BraveOriginStartup">
    Galeob
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_DESCRIPTION" desc="First paragraph of description on the Galeob startup dialog" formatter_data="webui=BraveOriginStartup">
    Welcome to Galeob. To continue, please buy or restore your Galeob purchase.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_DESCRIPTION2" desc="Second paragraph of description on the Galeob startup dialog" formatter_data="webui=BraveOriginStartup">
    You need an active Galeob purchase to use this browser.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_RESTORE_BUTTON" desc="Button label to restore a Galeob purchase" formatter_data="webui=BraveOriginStartup">
    Restore Galeob purchase
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_BUY_BUTTON" desc="Button label to buy Galeob" formatter_data="webui=BraveOriginStartup">
    Buy Galeob
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_RESTORE_TITLE" desc="Title for the restore view of the Galeob startup dialog" formatter_data="webui=BraveOriginStartup">
    Restore Purchase
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_RESTORE_DESCRIPTION" desc="Description for the restore view of the Galeob startup dialog" formatter_data="webui=BraveOriginStartup">
    Enter your purchase ID to activate your Galeob purchase.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_PURCHASE_ID_LABEL" desc="Label for the purchase ID input field" formatter_data="webui=BraveOriginStartup">
    Purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_PURCHASE_ID_PLACEHOLDER" desc="Placeholder for the purchase ID input field" formatter_data="webui=BraveOriginStartup">
    Enter your purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_VERIFY_BUTTON" desc="Button label to verify a purchase ID" formatter_data="webui=BraveOriginStartup">
    Verify purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_VERIFYING_MESSAGE" desc="Message shown while verifying a purchase ID" formatter_data="webui=BraveOriginStartup">
    Verifying… This may take a minute.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_FREE_DESCRIPTION" desc="First paragraph of description on the free-tier Galeob startup dialog" formatter_data="webui=BraveOriginStartup">
    Thanks for installing Galeob, a private browser that keeps the features you need while removing the rest. You still get industry-leading privacy, ad blocking, and speed (via Shields), as well as regular software updates, Chromium patches, and security and privacy improvements.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_FREE_DESCRIPTION2" desc="Second paragraph on the free-tier Galeob startup dialog with a link placeholder" formatter_data="webui=BraveOriginStartup">
    Galeob is free to use. If you would like to support the project, you can <ph name="BEGIN_LINK">$1<ex>&lt;a&gt;</ex></ph>make a donation<ph name="END_LINK">$2<ex>&lt;/a&gt;</ex></ph>.
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_FREE_BUY_BUTTON" desc="Button label to donate to Galeob on the free tier" formatter_data="webui=BraveOriginStartup">
    Support Galeob
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_FREE_BUTTON" desc="Button label to proceed with Galeob for free" formatter_data="webui=BraveOriginStartup">
    Continue with Galeob
  </message>

  <!-- The IDS_BRAVE_ORIGIN_STARTUP_ERROR_* messages are returned to the UI
       through the mojo VerifyPurchaseId callback and localized in C++ via
       l10n_util, so they are intentionally excluded from the WebUI JS bundle
       (no formatter_data="webui=BraveOriginStartup"). -->
  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_SKUS_CONNECTION" desc="Error message shown when the browser cannot connect to the purchase service while verifying a Galeob purchase ID">
    Unable to connect to SKU service
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_EMPTY_PURCHASE_ID" desc="Error message shown when the user submits an empty purchase ID in the Galeob restore dialog">
    Purchase ID is empty
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_INVALID_PURCHASE_ID" desc="Error message shown when the entered Galeob purchase ID is not valid">
    Invalid purchase ID
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_FETCH_CREDENTIALS" desc="Error message shown when fetching the credentials for a Galeob purchase fails">
    Failed to fetch credentials
  </message>

  <message name="IDS_BRAVE_ORIGIN_STARTUP_ERROR_PURCHASE_NOT_FOUND" desc="Error message shown when no Galeob purchase is found for the entered purchase ID">
    Purchase not found
  </message>
</grit-part>
